#!/usr/bin/env bash
set -u
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/capture-viewer"
config="$config_dir/config.json"
notify_error() {
    if command -v zenity >/dev/null; then zenity --error --title="Capture Viewer" --text="$1"; else notify-send "Capture Viewer" "$1"; fi
}
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/capture-viewer-${UID}.lock"
flock -n 9 || exit 0
if [[ $# -gt 0 && $1 != --configure ]] || [[ $# -gt 1 ]]; then echo "Usage: capture-viewer [--configure]" >&2; exit 2; fi
"$here/capture-viewer-config" "$config" || exit $?
readarray -t settings < <("$here/capture-viewer-config" --read "$config") || { notify_error "Configuration is invalid. Run Capture Viewer --configure."; exit 1; }
(( ${#settings[@]} == 4 )) || { notify_error "Configuration is incomplete. Run Capture Viewer --configure."; exit 1; }
video=${settings[0]} format=${settings[1]} size=${settings[2]} fps=${settings[3]}
logdir="${XDG_CACHE_HOME:-$HOME/.cache}/capture-viewer"
mkdir -p "$logdir"
[[ -r "$video" ]] || { notify_error "Selected video device is unavailable. Reconnect it or run --configure."; exit 1; }
source=$({ "$here/capture-viewer-config" --audio "$config"; } 2>/dev/null) || source=
if [[ -n "$source" ]] && ! pactl list short sources | cut -f2 | grep -Fxq -- "$source"; then
    notify_error "Selected audio source is unavailable. Run --configure to select another source or no audio."; exit 1
fi
audio_pid= video_pid=
cleanup() { [[ -z "$video_pid" ]] || kill "$video_pid" 2>/dev/null || true; [[ -z "$audio_pid" ]] || kill "$audio_pid" 2>/dev/null || true; wait 2>/dev/null || true; }
trap cleanup EXIT
trap 'exit 0' INT TERM HUP
if [[ -n "$source" ]]; then
    sink=$(pactl get-default-sink) || { notify_error "Could not determine the default audio output."; exit 1; }
    pw-loopback --name=capture-viewer-audio --capture="$source" --playback="$sink" --channels=2 --latency=20 >"$logdir/audio.log" 2>&1 & audio_pid=$!
fi
SDL_VIDEO_X11_WMCLASS=capture-viewer ffplay -hide_banner -loglevel warning -nostats \
    -window_title "Capture Viewer" -f v4l2 -input_format "$format" -video_size "$size" -framerate "$fps" \
    -fflags nobuffer -flags low_delay -framedrop -an -i "$video" >"$logdir/video.log" 2>&1 &
video_pid=$!
"$HOME/.local/bin/capture-viewer-window" "$video_pid" 2>>"$logdir/video.log" || true
wait "$video_pid"; result=$?; video_pid=
if (( result != 0 )); then notify_error "Unable to open video. Check whether another application is using the device."; fi
exit "$result"
